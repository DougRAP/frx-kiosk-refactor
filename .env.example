# .env.example — variables de entorno de FurnFX (Netlify Functions).
# Copiá a .env y completá con los valores reales. NUNCA commitees .env (está en .gitignore).
# Estos son los NOMBRES + ejemplos de formato, SIN secretos reales.

# ── Supabase (service_role: bypassa RLS, SOLO server) ───────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ──────────────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STAIN=price_xxx
STRIPE_PRICE_STAIN_MECH=price_xxx
STRIPE_PRICE_MEMBERSHIP=price_xxx
STRIPE_PRICE_MEMBERSHIP_FREE=price_xxx

# ── Anthropic (chat "Maya") ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx

# ── Dashboard sin login (token HMAC) + rate limiting ───────────────────────────────────────────
DASHBOARD_LINK_SECRET=
RATE_LIMIT_SALT=

# ── URLs de retorno / multi-dominio ─────────────────────────────────────────────────────────────
# Dominio canónico (SIN barra final). Fallback de retorno si el origen no está en la allowlist.
SITE_URL=https://www.furniturerx.net

# Allowlist de orígenes que pueden iniciar checkout (CSV). El backend devuelve success_url/cancel_url
# al origen REAL si está aquí → cada variante/dominio vuelve a SÍ MISMO (si no, cae a SITE_URL).
# Incluí el d2c + cada variante (kiosk, etc.). Los orígenes van SIN barra final (el header Origin no la
# trae); una barra final se tolera, pero lo canónico es sin "/".
ALLOWED_ORIGINS=https://www.furniturerx.net,https://kiosk.furniturerx.net
